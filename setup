#!/usr/bin/env bun
import { createHash } from "node:crypto";
import {
  chmodSync,
  cpSync,
  existsSync,
  lstatSync,
  mkdirSync,
  mkdtempSync,
  readdirSync,
  readFileSync,
  readlinkSync,
  realpathSync,
  renameSync,
  rmSync,
  rmdirSync,
  statSync,
  symlinkSync,
  writeFileSync,
} from "node:fs";
import { homedir, tmpdir } from "node:os";
import { basename, dirname, join, resolve } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const APP_VERSION = "0.2.0";
const DEFAULT_PACKAGE_PATH = ".claude-plugin/plugin.json";
const GIT_PREFIX = process.platform === "win32" ? ["-c", "core.longpaths=true"] : [];
const DEFAULT_PACKAGE_SELECTOR = "/skills";

type Json = null | boolean | number | string | Json[] | { [key: string]: Json };
type Entry = { name: string; source: string; path: string; ref: string };
type Package = Entry & { selector: string };
type OwnedSkill = { entry: Entry; fingerprint: string; package?: string };
type PackageState = { entry: Package; members: Entry[] };
type State = {
  version: 1;
  skills: Record<string, OwnedSkill>;
  packages: Record<string, PackageState>;
  rules: Record<string, { fingerprint: string }>;
};
type Manifest = { packages?: Package[]; skills: Entry[]; [key: string]: unknown };
type CommandResult = { status: number; stdout: string; stderr: string };
type Transaction = {
  name: string;
  backup: string;
  paths: string[];
  native: Json;
  owned: OwnedSkill | null;
  protected: number[];
};

class UserError extends Error {}

const REPO = dirname(realpathSync(fileURLToPath(import.meta.url)));
const RULES_FILE = join(REPO, "AGENTS.md");
const MANIFEST = join(REPO, "skills.json");
const MCP_MANIFEST = join(REPO, "mcps.json");
const SYSTEM_HOME = process.env.HOME || process.env.USERPROFILE || homedir();
const TARGET_HOME = process.env.AGENT_RECIPES_HOME || SYSTEM_HOME;
const GIT_BIN = process.env.AGENT_RECIPES_GIT || "git";
const BUNX_BIN = process.env.AGENT_RECIPES_BUNX || "bunx";

let force = false;
let stateRoot = "";
let statePath = "";
let backups = "";
let skillsDir = "";
let nativeLock = "";
let tmp = "";
let sourceCacheRoot = "";
let locked = false;
let manifestBaseHash = "";
let active: Transaction | null = null;
let verifiedEntry: Entry | null = null;
const refCache = new Map<string, string>();
const sourceCaches = new Map<string, string>();
const hydratedCaches = new Set<string>();

function say(message = ""): void {
  process.stdout.write(`${message}\n`);
}

function warn(message: string): void {
  process.stderr.write(`${message}\n`);
}

function err(message: string): void {
  warn(`error: ${message}`);
}

function die(message: string): never {
  throw new UserError(message);
}

function exists(path: string): boolean {
  try {
    lstatSync(path);
    return true;
  } catch {
    return false;
  }
}

function isDirectoryTarget(path: string): boolean {
  try {
    return statSync(path).isDirectory();
  } catch {
    return false;
  }
}

function isObject(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

function readJson<T>(path: string): T {
  return JSON.parse(readFileSync(path, "utf8").replace(/^\uFEFF/, "")) as T;
}

function canonical(value: unknown): string {
  if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
  if (isObject(value)) {
    return `{${Object.keys(value).sort().map((key) => `${JSON.stringify(key)}:${canonical(value[key])}`).join(",")}}`;
  }
  return JSON.stringify(value);
}

function sameJson(left: unknown, right: unknown): boolean {
  return canonical(left) === canonical(right);
}

function writeAtomic(path: string, contents: string, mode?: number): void {
  mkdirSync(dirname(path), { recursive: true });
  const candidate = join(dirname(path), `.${basename(path)}.${process.pid}.${Date.now()}.tmp`);
  writeFileSync(candidate, contents);
  if (mode !== undefined) chmodSync(candidate, mode);
  renameSync(candidate, path);
}

function writeJsonAtomic(path: string, value: unknown, mode?: number): void {
  writeAtomic(path, `${JSON.stringify(value, null, 2)}\n`, mode);
}

function fileHash(path: string): string {
  return createHash("sha256").update(readFileSync(path)).digest("hex");
}

function fingerprint(root: string): string {
  const hash = createHash("sha256");
  const walk = (path: string, relative: string): void => {
    const stat = lstatSync(path);
    const kind = stat.isSymbolicLink() ? "link" : stat.isDirectory() ? "dir" : "file";
    hash.update(JSON.stringify([relative, kind, stat.mode & 0o777]));
    if (stat.isSymbolicLink()) hash.update(readlinkSync(path));
    else if (stat.isDirectory()) {
      for (const name of readdirSync(path).sort()) walk(join(path, name), relative ? `${relative}/${name}` : name);
    } else if (stat.isFile()) hash.update(readFileSync(path));
    else die(`unsupported file type: ${path}`);
  };
  walk(realpathSync(root), "");
  return hash.digest("hex");
}

function run(command: string, args: string[], env: Record<string, string | undefined> = {}, quiet = false): CommandResult {
  let result;
  try {
    result = Bun.spawnSync([command, ...args], {
      env: { ...process.env, ...env },
      stdout: "pipe",
      stderr: "pipe",
    });
  } catch (error) {
    return { status: 127, stdout: "", stderr: String(error) };
  }
  const output = {
    status: result.exitCode ?? 1,
    stdout: new TextDecoder().decode(result.stdout),
    stderr: new TextDecoder().decode(result.stderr),
  };
  if (!quiet && output.stderr) process.stderr.write(output.stderr);
  return output;
}

function need(command: string): void {
  if (command.includes("/") || command.includes("\\")) {
    if (!existsSync(command)) die(`required command not found: ${command}`);
    return;
  }
  if (!Bun.which(command)) die(`required command not found: ${command}`);
}

function help(): void {
  say(`agent-recipes ${APP_VERSION}`);
  say();
  say(`Usage:
  ./setup [--force]                           Sync AGENTS.md and declared Skills
  ./setup skills list                        Show desired and installed state (read-only)
  ./setup skills add SOURCE --skill NAME [--path PATH] [--ref REF]
  ./setup skills remove NAME                 Remove this repository's managed Skill
  ./setup skills set NAME [--source URL] [--path PATH] [--ref REF]
  ./setup skills update [NAME]               Resolve upstream HEAD and upgrade
  ./setup packages list                      Show package-level state (read-only)
  ./setup packages add NAME SOURCE [--path MANIFEST] [--selector POINTER] [--ref REF]
  ./setup packages remove NAME               Remove a managed package
  ./setup packages set NAME [--source URL] [--path MANIFEST] [--selector POINTER] [--ref REF]
  ./setup packages update [NAME]             Resolve package HEAD and reconcile members
  ./setup mcp                                Show numbered MCP configuration steps (read-only)
  ./setup --version                          Show the repository release version

Windows: run ./setup in PowerShell or setup.cmd in Command Prompt.
SOURCE is an HTTPS GitHub repository URL; PATH is relative to that repository.
REF can be a commit, branch or tag; skills.json always stores a full commit SHA.
PACKAGE PATH defaults to ${DEFAULT_PACKAGE_PATH}. SELECTOR defaults to ${DEFAULT_PACKAGE_SELECTOR}.
--force backs up and replaces modified managed content or conflicting rule files.
MCP records are checked but never installed, started, authenticated or deployed.
Requires Git and Bun. Installer: bunx skills@latest.`);
}

function validateMcps(): Record<string, Record<string, unknown>> {
  let data: unknown;
  try {
    data = readJson<unknown>(MCP_MANIFEST);
  } catch {
    die("mcps.json is not a valid MCP declaration (no service was started)");
  }
  if (!isObject(data) || !isObject(data.mcpServers)) die("mcps.json is not a valid MCP declaration (no service was started)");
  for (const value of Object.values(data.mcpServers)) {
    if (!isObject(value)) die("mcps.json is not a valid MCP declaration (no service was started)");
    if (value.type === "http" && typeof value.url === "string" && /^https?:\/\//.test(value.url)) continue;
    if (
      value.type === "stdio" &&
      typeof value.command === "string" &&
      value.command.length > 0 &&
      (value.args === undefined || (Array.isArray(value.args) && value.args.every((item) => typeof item === "string")))
    ) continue;
    die("mcps.json is not a valid MCP declaration (no service was started)");
  }
  return data.mcpServers as Record<string, Record<string, unknown>>;
}

function mcpGuide(): void {
  const records = Object.entries(validateMcps()).map(([name, value]) => `${name} (${String(value.type)})`).join(", ");
  say("MCP 配置指引");
  say(`当前记录：${records || "无"}`);
  say();
  say(`1. 查看 "${MCP_MANIFEST}"，确认所需 MCP。`);
  say("2. 选择目标客户端：Codex、Claude、DSH、Cursor、Zed 或 VS Code。");
  say("3. 将下方提示交给 Agent，让它按目标客户端的官方配置格式处理。");
  say("4. 按需在本机完成认证，并按客户端要求重载配置。");
  say("5. 实际调用一次 MCP 工具，核对返回结果并报告未完成项。");
  say();
  say("可复制给 Agent：");
  say(`参考 "${MCP_MANIFEST}"，为本机的【目标客户端】增补或更新清单中的 MCP。保留其他 MCP、客户端设置和本机凭据，完成后回读核对并验证工具调用；无法验证时说明原因。`);
}

function validName(value: unknown): value is string {
  return typeof value === "string" && /^[a-z0-9][a-z0-9-]*$/.test(value);
}

function validSource(value: unknown): value is string {
  return typeof value === "string" && /^https:\/\/github\.com\/[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/.test(value);
}

function validPath(value: unknown): value is string {
  return typeof value === "string" && value.length > 0 && !/^\/|\\|[\r\n\t]|(^|\/)\.\.(\/|$)/.test(value);
}

function validSelector(value: unknown): value is string {
  return typeof value === "string" && value.startsWith("/") && !/[\r\n\t]/.test(value);
}

function validRef(value: unknown): value is string {
  return typeof value === "string" && /^[0-9a-f]{40}$/.test(value);
}

function hasKeys(value: Record<string, unknown>, keys: string[]): boolean {
  return Object.keys(value).sort().join("\0") === [...keys].sort().join("\0");
}

function readManifest(): Manifest {
  let data: unknown;
  try {
    data = readJson<unknown>(MANIFEST);
  } catch {
    die("skills.json must contain valid package and Skill entries with pinned commits");
  }
  if (!isObject(data) || !Array.isArray(data.skills)) die("skills.json must contain valid package and Skill entries with pinned commits");
  const packages = data.packages ?? [];
  if (!Array.isArray(packages)) die("skills.json must contain valid package and Skill entries with pinned commits");
  const names = new Set<string>();
  for (const item of data.skills) {
    if (
      !isObject(item) ||
      !hasKeys(item, ["name", "path", "ref", "source"]) ||
      !validName(item.name) ||
      !validSource(item.source) ||
      !validPath(item.path) ||
      !validRef(item.ref) ||
      names.has(item.name)
    ) die("skills.json must contain valid package and Skill entries with pinned commits");
    names.add(item.name);
  }
  for (const item of packages) {
    if (
      !isObject(item) ||
      !hasKeys(item, ["name", "path", "ref", "selector", "source"]) ||
      !validName(item.name) ||
      !validSource(item.source) ||
      !validPath(item.path) ||
      !validSelector(item.selector) ||
      !validRef(item.ref) ||
      names.has(item.name)
    ) die("skills.json must contain valid package and Skill entries with pinned commits");
    names.add(item.name);
  }
  return data as Manifest;
}

function emptyState(): State {
  return { version: 1, skills: {}, packages: {}, rules: {} };
}

function readState(): State {
  if (!existsSync(statePath)) return emptyState();
  const data = readJson<Partial<State>>(statePath);
  return {
    version: 1,
    skills: data.skills ?? {},
    packages: data.packages ?? {},
    rules: data.rules ?? {},
  };
}

function putState<K extends "skills" | "packages" | "rules">(section: K, key: string, value: State[K][string] | null): void {
  const state = readState();
  if (value === null) delete state[section][key];
  else state[section][key] = value as never;
  writeJsonAtomic(statePath, state, 0o600);
}

function ownedSkill(name: string): OwnedSkill | null {
  return readState().skills[name] ?? null;
}

function packageState(name: string): PackageState | null {
  return readState().packages[name] ?? null;
}

function currentEntry(name: string): Entry | undefined {
  return readManifest().skills.find((item) => item.name === name);
}

function currentPackage(name: string): Package | undefined {
  return (readManifest().packages ?? []).find((item) => item.name === name);
}

function checkName(name: string): void {
  if (!validName(name)) die(`invalid Skill name: ${name}`);
}

function normalizeSource(value: string): string {
  const source = value.replace(/\/$/, "").replace(/\.git$/, "");
  if (!validSource(source)) die("source must be an HTTPS GitHub repository URL without credentials or query");
  return source;
}

function checkPath(path: string): void {
  if (!validPath(path)) die("path must stay inside the source repository");
}

function checkSelector(selector: string): void {
  if (!validSelector(selector)) die("selector must be a JSON Pointer such as /skills");
}

function sourceCacheName(source: string, ref: string): string {
  return createHash("sha256").update(`${source}\0${ref}`).digest("hex").slice(0, 16);
}

function gitNetwork(args: string[], quiet = false): CommandResult {
  const command = [...GIT_PREFIX, ...args];
  const first = run(GIT_BIN, command, { GIT_LFS_SKIP_SMUDGE: "1" }, quiet);
  if (first.status === 0) return first;
  const config = join(tmp, "empty.gitconfig");
  writeFileSync(config, "");
  err("retrying Git access without global URL rewrites");
  return run(GIT_BIN, command, { GIT_CONFIG_GLOBAL: config, GIT_CONFIG_NOSYSTEM: "1", GIT_LFS_SKIP_SMUDGE: "1" }, quiet);
}

function git(args: string[], quiet = false): CommandResult {
  return run(GIT_BIN, [...GIT_PREFIX, ...args], {}, quiet);
}

function resolveRef(source: string, requested = ""): string {
  if (validRef(requested)) return requested;
  if (requested.startsWith("-")) die("ref cannot start with an option");
  if (!requested && refCache.has(source)) return refCache.get(source)!;
  const result = requested
    ? gitNetwork(["ls-remote", source, requested, `refs/heads/${requested}`, `refs/tags/${requested}`, `refs/tags/${requested}*`])
    : gitNetwork(["ls-remote", "--symref", source, "HEAD"]);
  if (result.status !== 0) die("upstream ref could not be resolved");
  const tag = `refs/tags/${requested}`;
  const rows = result.stdout
    .trim()
    .split(/\r?\n/)
    .filter(Boolean)
    .map((line) => line.split(/\s+/))
    .filter(([, ref]) => !requested || !ref?.startsWith(tag) || ref === tag || ref === `${tag}^{}`);
  let refs: string[];
  if (!requested) refs = rows.filter(([sha, ref]) => ref === "HEAD" && validRef(sha)).map(([sha]) => sha);
  else if (rows.some(([, ref]) => ref?.endsWith("^{}"))) refs = rows.filter(([, ref]) => ref !== `refs/tags/${requested}`).map(([sha]) => sha);
  else refs = rows.filter(([sha]) => validRef(sha)).map(([sha]) => sha);
  const unique = [...new Set(refs)];
  if (unique.length !== 1 || !validRef(unique[0])) die("upstream ref is absent or ambiguous");
  if (!requested) refCache.set(source, unique[0]);
  return unique[0];
}

function prepareSourceCache(source: string, ref: string): string {
  const key = `${source}\0${ref}`;
  if (sourceCaches.has(key)) return sourceCaches.get(key)!;
  const cache = join(sourceCacheRoot, sourceCacheName(source, ref));
  mkdirSync(cache, { recursive: true });
  if (!existsSync(join(cache, ".git"))) {
    if (git(["init", "-q", cache]).status !== 0 || git(["-C", cache, "remote", "add", "origin", `${source}.git`]).status !== 0) {
      die(`could not prepare source cache: ${source}`);
    }
  }
  if (gitNetwork(["-C", cache, "fetch", "--quiet", "--depth=1", "--filter=blob:none", "origin", ref]).status !== 0) {
    die(`could not fetch source: ${source}`);
  }
  const kind = git(["-C", cache, "cat-file", "-t", ref], true);
  if (kind.status !== 0 || kind.stdout.trim() !== "commit") die(`source commit was not fetched: ${ref}`);
  sourceCaches.set(key, cache);
  return cache;
}

function hydrateSourceCache(cache: string, ref: string): void {
  if (hydratedCaches.has(cache)) return;
  if (gitNetwork(["-C", cache, "checkout", "--quiet", "--force", "--detach", ref]).status !== 0) die("could not prepare installer source");
  hydratedCaches.add(cache);
}

function sourceCacheConfig(source: string, cache: string): string {
  const config = join(cache, "gitconfig");
  const url = pathToFileURL(cache).href;
  const core = process.platform === "win32" ? "[core]\n\tlongpaths = true\n" : "";
  writeFileSync(config, `${core}[url "${url}"]\n\tinsteadOf = ${source}\n\tinsteadOf = ${source}.git\n`);
  return config;
}

function pointerGet(value: unknown, pointer: string): unknown {
  let current = value;
  for (const raw of pointer.split("/").slice(1)) {
    const part = raw.replace(/~1/g, "/").replace(/~0/g, "~");
    if (Array.isArray(current) && /^(0|[1-9][0-9]*)$/.test(part)) current = current[Number(part)];
    else if (isObject(current)) current = current[part];
    else return undefined;
  }
  return current;
}

function packageStateMatches(pkg: Package): boolean {
  const state = packageState(pkg.name);
  return state !== null && sameJson(state.entry, pkg) && Array.isArray(state.members);
}

function resolvePackageEntries(pkg: Package, refresh: boolean): Entry[] {
  if (!refresh && packageStateMatches(pkg)) return packageState(pkg.name)!.members;
  checkPath(pkg.path);
  const cache = prepareSourceCache(pkg.source, pkg.ref);
  const content = git(["-C", cache, "show", `${pkg.ref}:${pkg.path}`], true);
  if (content.status !== 0) die(`package manifest not found: ${pkg.name} (${pkg.path})`);
  let data: unknown;
  try {
    data = JSON.parse(content.stdout);
  } catch {
    die(`package manifest is invalid: ${pkg.name} (${pkg.path})`);
  }
  const members = pointerGet(data, pkg.selector);
  if (!isObject(data) || !Array.isArray(members) || members.length === 0) die(`package manifest is invalid: ${pkg.name} (${pkg.path})`);
  const entries = members.map((member) => {
    if (typeof member !== "string" || !validPath(member)) die(`package manifest is invalid: ${pkg.name} (${pkg.path})`);
    const path = member.replace(/^\.\//, "").replace(/\/$/, "");
    return { name: path.split("/").at(-1)!, source: pkg.source, path, ref: pkg.ref };
  });
  const names = entries.map((entry) => entry.name);
  if (names.some((name) => !validName(name)) || new Set(names).size !== names.length) die(`package manifest is invalid: ${pkg.name} (${pkg.path})`);
  return entries;
}

function recordPackageState(pkg: Package, members: Entry[]): void {
  putState("packages", pkg.name, { entry: pkg, members });
}

function effectiveEntries(): Array<{ package: string | null; entry: Entry }> {
  const manifest = readManifest();
  const rows = manifest.skills.map((entry) => ({ package: null, entry }));
  for (const pkg of manifest.packages ?? []) {
    rows.push(...resolvePackageEntries(pkg, false).map((entry) => ({ package: pkg.name, entry })));
  }
  const names = rows.map((row) => row.entry.name);
  if (new Set(names).size !== names.length) die("package and standalone Skill names must be unique");
  return rows;
}

function lockData(): Record<string, unknown> {
  if (!existsSync(nativeLock)) return { version: 3, skills: {} };
  return readJson<Record<string, unknown>>(nativeLock);
}

function lockEntry(name: string): Json {
  const data = lockData();
  return (isObject(data.skills) ? data.skills[name] : null) as Json ?? null;
}

function nativePath(native: Record<string, unknown>): string {
  const skillPath = String(native.skillPath ?? "");
  return skillPath === "SKILL.md" ? "." : skillPath.replace(/\/SKILL\.md$/, "");
}

function nativeMatches(entry: Entry): boolean {
  const native = lockEntry(entry.name);
  if (!isObject(native)) return false;
  return (
    native.ref === entry.ref &&
    native.sourceType === "github" &&
    native.source === entry.source.replace(/^https:\/\/github\.com\//, "") &&
    (native.sourceUrl === entry.source || native.sourceUrl === `${entry.source}.git`) &&
    typeof native.skillPath === "string" &&
    native.skillPath.length > 0 &&
    (entry.path === "?" || nativePath(native) === entry.path)
  );
}

function restoreLockEntry(name: string, value: Json): void {
  const data = lockData();
  const skills = isObject(data.skills) ? data.skills : {};
  if (value === null) delete skills[name];
  else skills[name] = value;
  data.skills = skills;
  writeJsonAtomic(nativeLock, data);
}

function remoteSkillHash(cache: string, ref: string, path: string): string {
  const spec = path === "." ? `${ref}:` : `${ref}:${path}`;
  const kind = git(["-C", cache, "cat-file", "-t", spec], true);
  if (kind.status !== 0 || kind.stdout.trim() !== "tree") die(`upstream Skill path is not a directory: ${path}`);
  const hash = git(["-C", cache, "rev-parse", spec], true);
  if (hash.status !== 0) die(`could not read upstream Skill path: ${path}`);
  return hash.stdout.trim();
}

function nativeContentMatches(entry: Entry, cache: string): boolean {
  if (entry.path === "?") return false;
  const owned = ownedSkill(entry.name);
  const installed = join(skillsDir, entry.name, "SKILL.md");
  if (!owned || !existsSync(installed) || fingerprint(join(skillsDir, entry.name)) !== owned.fingerprint) return false;
  const native = lockEntry(entry.name);
  return (
    isObject(native) &&
    native.source === entry.source.replace(/^https:\/\/github\.com\//, "") &&
    native.sourceType === "github" &&
    native.skillFolderHash === remoteSkillHash(cache, entry.ref, entry.path) &&
    nativePath(native) === entry.path
  );
}

function updateEntryMetadata(entry: Entry, persist: boolean, packageName = ""): void {
  const owned = ownedSkill(entry.name);
  const native = lockEntry(entry.name);
  if (!owned || !isObject(native)) die(`missing managed state: ${entry.name}`);
  const now = new Date().toISOString();
  transactionBegin(entry.name);
  try {
    restoreLockEntry(entry.name, { ...native, ref: entry.ref, installedAt: native.installedAt ?? now, updatedAt: now } as Json);
    putState("skills", entry.name, { ...owned, entry, ...(packageName ? { package: packageName } : {}) });
    if (persist) commitManifest(manifestWith(entry.name, entry));
    active = null;
    say(`updated metadata: ${entry.name} (${entry.ref})`);
  } catch (error) {
    transactionRollback();
    throw error;
  }
}

function commitManifest(candidate: Manifest): void {
  if (fileHash(MANIFEST) !== manifestBaseHash) die("skills.json changed externally; preserving that edit");
  candidate.skills.sort((left, right) => left.name.localeCompare(right.name));
  candidate.packages = [...(candidate.packages ?? [])].sort((left, right) => left.name.localeCompare(right.name));
  writeJsonAtomic(MANIFEST, candidate, 0o644);
  manifestBaseHash = fileHash(MANIFEST);
}

function manifestWith(name: string, entry: Entry | null): Manifest {
  const manifest = readManifest();
  manifest.skills = manifest.skills.filter((item) => item.name !== name);
  if (entry) manifest.skills.push(entry);
  return manifest;
}

function packageManifestWith(name: string, pkg: Package | null): Manifest {
  const manifest = readManifest();
  manifest.packages = (manifest.packages ?? []).filter((item) => item.name !== name);
  if (pkg) manifest.packages.push(pkg);
  return manifest;
}

function skillPaths(name: string): string[] {
  const paths = [join(skillsDir, name)];
  const collect = (root: string, pattern: (entry: string) => string): void => {
    let entries: string[];
    try {
      entries = readdirSync(root);
    } catch {
      return;
    }
    for (const item of entries) {
      const candidate = pattern(item);
      if (candidate !== paths[0] && exists(candidate) && !/[\r\n]/.test(candidate)) paths.push(candidate);
    }
  };
  collect(TARGET_HOME, (item) => join(TARGET_HOME, item, "skills", name));
  collect(join(TARGET_HOME, ".config"), (item) => join(TARGET_HOME, ".config", item, "skills", name));
  return paths;
}

function sharedSkillPath(alias: string, name: string): boolean {
  const canonicalPath = join(skillsDir, name);
  try {
    return realpathSync(alias) === realpathSync(canonicalPath);
  } catch {
    try {
      return resolve(dirname(alias), readlinkSync(alias)) === resolve(canonicalPath);
    } catch {
      return false;
    }
  }
}

function foreignSkillPaths(name: string): string[] {
  return skillPaths(name).filter((path) => path !== join(skillsDir, name) && exists(path) && !sharedSkillPath(path, name));
}

function transactionBegin(name: string): void {
  const backup = mkdtempSync(join(backups, `skill-${name}.`));
  const paths = skillPaths(name);
  paths.forEach((path, index) => {
    if (exists(path)) cpSync(path, join(backup, `item-${index}`), { recursive: true, verbatimSymlinks: true });
  });
  active = { name, backup, paths, native: lockEntry(name), owned: ownedSkill(name), protected: [] };
}

function protectForeignPaths(): void {
  if (!active) return;
  active.paths.forEach((path, index) => {
    if (path !== join(skillsDir, active!.name) && exists(path) && !sharedSkillPath(path, active!.name)) {
      renameSync(path, join(active!.backup, `protected-${index}`));
      active!.protected.push(index);
    }
  });
}

function restoreForeignPaths(): void {
  if (!active) return;
  for (const index of active.protected) {
    const path = active.paths[index];
    if (exists(path)) rmSync(path, { recursive: true, force: true });
    mkdirSync(dirname(path), { recursive: true });
    renameSync(join(active.backup, `protected-${index}`), path);
    warn(`warning: independent Skill copy preserved: ${path}`);
  }
  active.protected = [];
}

function transactionRollback(): void {
  if (!active) return;
  const transaction = active;
  active = null;
  let failed = false;
  for (const path of skillPaths(transaction.name)) {
    try {
      if (exists(path)) rmSync(path, { recursive: true, force: true });
    } catch {
      failed = true;
    }
  }
  transaction.paths.forEach((path, index) => {
    const backup = join(transaction.backup, `item-${index}`);
    try {
      if (exists(backup)) {
        mkdirSync(dirname(path), { recursive: true });
        cpSync(backup, path, { recursive: true, verbatimSymlinks: true });
      }
    } catch {
      failed = true;
    }
  });
  try {
    restoreLockEntry(transaction.name, transaction.native);
    putState("skills", transaction.name, transaction.owned);
  } catch {
    failed = true;
  }
  if (failed) err(`rollback incomplete; recovery data: ${transaction.backup}`);
  else err(`restored ${transaction.name}; recovery data: ${transaction.backup}`);
}

function ensureMutation(): void {
  need(GIT_BIN);
  mkdirSync(backups, { recursive: true });
  mkdirSync(skillsDir, { recursive: true });
  const lock = join(stateRoot, ".running");
  try {
    mkdirSync(lock);
  } catch {
    die(`another setup is running (or a stale lock exists): ${lock}`);
  }
  locked = true;
  if (existsSync(statePath)) {
    const state = readJson<Record<string, unknown>>(statePath);
    if (state.version !== 1 || !isObject(state.skills) || !isObject(state.rules)) die("invalid local ownership state");
  }
  tmp = mkdtempSync(join(stateRoot, ".work."));
  sourceCacheRoot = join(tmp, "source-cache");
  mkdirSync(sourceCacheRoot);
  manifestBaseHash = fileHash(MANIFEST);
}

function ensureInstaller(): void {
  need(BUNX_BIN);
  if (resolve(TARGET_HOME) !== resolve(SYSTEM_HOME) && !process.env.AGENT_RECIPES_BUNX) {
    die("an alternate target home requires an explicit installer helper; real global installation was refused");
  }
}

function checkSkillDrift(name: string): void {
  const owned = ownedSkill(name);
  const target = join(skillsDir, name);
  if (owned && exists(target) && fingerprint(target) !== owned.fingerprint && !force) {
    die(`managed Skill ${name} was edited locally; use --force to back up and replace it`);
  }
}

function verifyInstall(entry: Entry, receiptPath: string): void {
  let receipt: unknown;
  try {
    receipt = JSON.parse(readFileSync(receiptPath, "utf8"));
  } catch {
    die("installer JSON receipt did not confirm the requested Skill and commit");
  }
  if (
    !Array.isArray(receipt) ||
    receipt.length === 0 ||
    !receipt.every((item) => isObject(item) && item.status === "installed") ||
    !receipt.some((item) => isObject(item) && item.name === entry.name && item.ref === entry.ref && typeof item.path === "string" && item.path)
  ) die("installer JSON receipt did not confirm the requested Skill and commit");
  const installed = join(skillsDir, entry.name);
  if (!existsSync(join(installed, "SKILL.md"))) die("installer did not create the canonical Skill directory");
  const receiptPathValue = (receipt.find((item) => isObject(item) && item.name === entry.name) as Record<string, unknown>).path as string;
  if (realpathSync(receiptPathValue) !== realpathSync(installed)) die("installer receipt path does not match the canonical directory");
  if (!nativeMatches(entry)) die("native lock does not confirm the requested remote source, path and commit");
  const native = lockEntry(entry.name) as Record<string, unknown>;
  const actualPath = nativePath(native);
  checkPath(actualPath);
  if (entry.path !== "?" && entry.path !== actualPath) die(`native lock path differs from the requested path for ${entry.name}`);
  verifiedEntry = { ...entry, path: actualPath };
}

function installEntry(entry: Entry, persist: boolean, packageName = ""): void {
  checkSkillDrift(entry.name);
  const owned = ownedSkill(entry.name);
  const installed = join(skillsDir, entry.name);
  if (owned && existsSync(join(installed, "SKILL.md"))) {
    if (sameJson(owned.entry, entry) && owned.fingerprint === fingerprint(installed) && nativeMatches(entry)) {
      const foreign = foreignSkillPaths(entry.name);
      if (foreign.length) warn(`warning: independent Skill copies remain: ${foreign.join("\n")}`);
      if (packageName && owned.package !== packageName) putState("skills", entry.name, { ...owned, package: packageName });
      say(`unchanged: ${entry.name}`);
      return;
    }
  }
  const cache = prepareSourceCache(entry.source, entry.ref);
  if ((persist || packageName) && nativeContentMatches(entry, cache)) {
    const foreign = foreignSkillPaths(entry.name);
    if (foreign.length) warn(`warning: independent Skill copies remain: ${foreign.join("\n")}`);
    updateEntryMetadata(entry, persist, packageName);
    return;
  }
  hydrateSourceCache(cache, entry.ref);
  ensureInstaller();
  if (fileHash(MANIFEST) !== manifestBaseHash) die("skills.json changed externally");
  transactionBegin(entry.name);
  try {
    protectForeignPaths();
    if (exists(installed)) renameSync(installed, join(active!.backup, "detached"));
    let url = `${entry.source}/tree/${entry.ref}`;
    if (entry.path !== "." && entry.path !== "?") url += `/${entry.path}`;
    say(`installing: ${entry.name} (${entry.ref})`);
    const config = sourceCacheConfig(entry.source, cache);
    const result = run(
      BUNX_BIN,
      ["skills@latest", "add", url, "--global", "--skill", entry.name, "--agent", "universal", "--yes", "--json"],
      { GIT_CONFIG_GLOBAL: config, GIT_CONFIG_NOSYSTEM: "1" },
    );
    const receipt = join(active!.backup, "receipt.json");
    writeFileSync(receipt, result.stdout);
    if (result.status !== 0) die(`installation failed: ${entry.name} (installer exit ${result.status})`);
    verifyInstall(entry, receipt);
    restoreForeignPaths();
    const fp = fingerprint(installed);
    putState("skills", entry.name, { entry: verifiedEntry!, fingerprint: fp, ...(packageName ? { package: packageName } : {}) });
    if (persist) commitManifest(manifestWith(entry.name, verifiedEntry));
    active = null;
    say(`installed: ${entry.name} (${entry.ref})`);
  } catch (error) {
    transactionRollback();
    throw error;
  }
}

function ruleOwned(target: string): boolean {
  if (!exists(target)) return true;
  if (!existsSync(target)) return false;
  const old = readState().rules[target]?.fingerprint;
  return Boolean(old) && fingerprint(target) === old;
}

function backupRule(target: string): void {
  if (!exists(target)) return;
  const dir = mkdtempSync(join(backups, "rule."));
  cpSync(target, join(dir, "original"), { recursive: true, verbatimSymlinks: true });
  writeFileSync(join(dir, "path"), `${target}\n`);
}

function recordRule(target: string): void {
  putState("rules", target, { fingerprint: fingerprint(target) });
}

function filesEqual(left: string, right: string): boolean {
  try {
    return readFileSync(left).equals(readFileSync(right));
  } catch {
    return false;
  }
}

function syncLink(target: string, source: string): void {
  if (isDirectoryTarget(target)) die(`rule target is a directory: ${target}`);
  if (exists(target) && lstatSync(target).isSymbolicLink() && readlinkSync(target) === source) {
    recordRule(target);
    say(`unchanged rule: ${target}`);
    return;
  }
  if (exists(target) && !filesEqual(target, source) && !ruleOwned(target) && !force) die(`rule conflict: ${target} (use --force to back up and replace)`);
  if (isDirectoryTarget(target)) die(`rule target is a directory: ${target}`);
  mkdirSync(dirname(target), { recursive: true });
  backupRule(target);
  const temporary = `${target}.agent-recipes-${process.pid}`;
  rmSync(temporary, { force: true, recursive: true });
  try {
    symlinkSync(source, temporary, "file");
  } catch {
    cpSync(source, temporary);
  }
  renameSync(temporary, target);
  if (!filesEqual(target, source)) die(`rule target was not written: ${target}`);
  recordRule(target);
  say(`synced rule: ${target}`);
}

function clientPresent(client: string): boolean {
  if (existsSync(join(TARGET_HOME, `.${client}`))) return true;
  if (resolve(TARGET_HOME) !== resolve(SYSTEM_HOME)) return false;
  if (client === "codex" && process.env.CODEX_HOME && existsSync(process.env.CODEX_HOME)) return true;
  if (Bun.which(client)) return true;
  return client === "cursor" && existsSync("/Applications/Cursor.app");
}

function syncRules(): boolean {
  let failed = false;
  const canonicalPath = join(TARGET_HOME, ".agents", "AGENTS.md");
  try {
    syncLink(canonicalPath, RULES_FILE);
  } catch (error) {
    reportError(error);
    return false;
  }
  for (const client of ["codex", "claude", "dsh"]) {
    if (!clientPresent(client)) continue;
    let target = client === "claude" ? join(TARGET_HOME, ".claude", "CLAUDE.md") : join(TARGET_HOME, `.${client}`, "AGENTS.md");
    if (client === "codex" && resolve(TARGET_HOME) === resolve(SYSTEM_HOME) && process.env.CODEX_HOME) target = join(process.env.CODEX_HOME, "AGENTS.md");
    try {
      syncLink(target, canonicalPath);
    } catch (error) {
      reportError(error);
      failed = true;
    }
  }
  if (clientPresent("cursor")) {
    const target = join(TARGET_HOME, ".cursor", "rules", "global-principles.mdc");
    const generated = join(tmp, "cursor.mdc");
    writeFileSync(generated, `---\ndescription: 个人全局规则\nalwaysApply: true\n---\n\n<!-- Generated by agent-recipes; edit AGENTS.md. -->\n\n${readFileSync(RULES_FILE, "utf8")}`);
    try {
      if (isDirectoryTarget(target)) die(`rule target is a directory: ${target}`);
      if (exists(target) && filesEqual(target, generated)) say(`unchanged rule: ${target}`);
      else if (exists(target) && !ruleOwned(target) && !force) die(`rule conflict: ${target} (use --force to back up and replace)`);
      else {
        if (isDirectoryTarget(target)) die(`rule target is a directory: ${target}`);
        mkdirSync(dirname(target), { recursive: true });
        backupRule(target);
        const temporary = `${target}.agent-recipes-${process.pid}`;
        cpSync(generated, temporary);
        renameSync(temporary, target);
        if (!filesEqual(target, generated)) die(`rule target was not written: ${target}`);
        recordRule(target);
        say(`synced rule: ${target}`);
      }
    } catch (error) {
      reportError(error);
      failed = true;
    }
  }
  return !failed;
}

function listSkills(): void {
  say("NAME\tDESIRED REF\tINSTALLED REF\tSTATUS\tOWNER");
  for (const row of effectiveEntries()) {
    const entry = row.entry;
    const native = lockEntry(entry.name);
    const installedRef = isObject(native) && typeof native.ref === "string" ? native.ref : "-";
    let status = "missing";
    const installed = join(skillsDir, entry.name);
    if (existsSync(join(installed, "SKILL.md"))) {
      const owned = ownedSkill(entry.name);
      if (!owned) status = "unmanaged";
      else if (!nativeMatches(entry) || !sameJson(owned.entry, entry)) status = "outdated";
      else if (row.package && owned.package !== row.package) status = "outdated";
      else status = fingerprint(installed) === owned.fingerprint ? "installed" : "modified";
    }
    if (foreignSkillPaths(entry.name).length) status += "+external";
    say(`${entry.name}\t${entry.ref}\t${installedRef}\t${status}\t${row.package ?? "-"}`);
  }
}

function listPackages(): void {
  say("NAME\tDESIRED REF\tINSTALLED REF\tMEMBERS\tSTATUS");
  for (const pkg of readManifest().packages ?? []) {
    const state = packageState(pkg.name);
    const members = resolvePackageEntries(pkg, false);
    let status = "missing";
    if (packageStateMatches(pkg)) {
      status = "installed";
      for (const member of members) {
        const installed = join(skillsDir, member.name);
        const owned = ownedSkill(member.name);
        let memberStatus = "installed";
        if (!existsSync(join(installed, "SKILL.md")) || !owned || owned.package !== pkg.name) memberStatus = "incomplete";
        else if (!nativeMatches(member) || !sameJson(owned.entry, member)) memberStatus = "outdated";
        else if (fingerprint(installed) !== owned.fingerprint) memberStatus = "modified";
        if (foreignSkillPaths(member.name).length) memberStatus += "+external";
        if (memberStatus !== "installed") {
          status = memberStatus;
          break;
        }
      }
    } else if (state) status = "outdated";
    say(`${pkg.name}\t${pkg.ref}\t${state?.entry.ref ?? "-"}\t${members.length}\t${status}`);
  }
}

function removeInstalledSkill(name: string): void {
  checkName(name);
  if (!ownedSkill(name)) return;
  checkSkillDrift(name);
  const foreign = foreignSkillPaths(name);
  if (foreign.length) die(`independent same-name installations exist; installation was preserved: ${foreign.join("\n")}`);
  ensureInstaller();
  transactionBegin(name);
  try {
    const result = run(BUNX_BIN, ["skills@latest", "remove", name, "--global", "--agent", "universal", "--yes"]);
    if (result.stdout) process.stdout.write(result.stdout);
    if (result.status !== 0) die(`removal failed: ${name}`);
    if (exists(join(skillsDir, name)) || lockEntry(name) !== null) die("native removal was incomplete");
    putState("skills", name, null);
    active = null;
    say(`removed: ${name}`);
  } catch (error) {
    transactionRollback();
    throw error;
  }
}

function removeSkill(name: string): void {
  checkName(name);
  if (currentPackage(name)) die(`Skill is managed by package ${name}; use packages remove`);
  const owned = ownedSkill(name);
  if (owned?.package) die(`Skill is managed by package ${owned.package}; use packages remove`);
  if (!currentEntry(name)) die(`Skill is not in this repository: ${name}`);
  if (!owned) {
    commitManifest(manifestWith(name, null));
    say(`removed declaration: ${name} (unmanaged local installation, if any, was preserved)`);
    return;
  }
  removeInstalledSkill(name);
  commitManifest(manifestWith(name, null));
}

function packageContainsMember(packageName: string, member: string): boolean {
  return packageState(packageName)?.members.some((item) => item.name === member) ?? false;
}

function packageForMember(member: string): string {
  return ownedSkill(member)?.package ?? "";
}

function installPackage(pkg: Package, persist: boolean, refresh: boolean, selectedMember = ""): void {
  const oldMembers = packageState(pkg.name)?.members ?? [];
  const members = resolvePackageEntries(pkg, refresh);
  if (selectedMember) {
    const oldNames = oldMembers.map((item) => item.name).sort();
    const newNames = members.map((item) => item.name).sort();
    if (!sameJson(oldNames, newNames)) die(`package membership changed; run packages update instead: ${pkg.name}`);
    if (!members.some((item) => item.name === selectedMember)) die(`package member not found upstream: ${selectedMember}`);
  }
  const removed = oldMembers.filter((old) => !members.some((item) => item.name === old.name)).map((item) => item.name);
  for (const member of removed) {
    const owned = ownedSkill(member);
    if (!owned) continue;
    if (owned.package !== pkg.name && owned.entry.source !== pkg.source) die(`refusing to remove a replaced package member: ${member}`);
    checkSkillDrift(member);
    if (foreignSkillPaths(member).length) die(`refusing to remove package member with independent copies: ${member}`);
  }
  for (const member of members) {
    if (currentEntry(member.name)) die(`package member conflicts with a standalone Skill: ${member.name}`);
    const owner = ownedSkill(member.name)?.package;
    if (owner && owner !== pkg.name) die(`package member is owned by another package: ${member.name} (${owner})`);
    for (const other of readManifest().packages ?? []) {
      if (other.name !== pkg.name && packageContainsMember(other.name, member.name)) die(`package member is owned by another package: ${member.name} (${other.name})`);
    }
  }
  for (const member of members) {
    if (!selectedMember || member.name === selectedMember) installEntry(member, false, pkg.name);
  }
  for (const member of removed) removeInstalledSkill(member);
  recordPackageState(pkg, members);
  if (persist) commitManifest(packageManifestWith(pkg.name, pkg));
  say(selectedMember ? `package member synced: ${selectedMember} (${pkg.ref})` : `package synced: ${pkg.name} (${pkg.ref})`);
}

function removePackage(name: string): void {
  checkName(name);
  if (!currentPackage(name)) die(`package is not declared: ${name}`);
  for (const member of packageState(name)?.members ?? []) removeInstalledSkill(member.name);
  const candidate = packageManifestWith(name, null);
  putState("packages", name, null);
  commitManifest(candidate);
  say(`removed package: ${name}`);
}

function takeValue(args: string[], option: string): string {
  const value = args.shift();
  if (value === undefined) die(`${option} requires a value`);
  return value;
}

function addOrSet(action: "add" | "set", args: string[]): void {
  let source = "";
  let name = "";
  let path = "";
  let requested = "";
  let seen = false;
  let sourceChanged = false;
  let pathExplicit = false;
  let refExplicit = false;
  let originalSource = "";
  if (action === "add") {
    source = args.shift() ?? die("add requires SOURCE");
  } else {
    name = args.shift() ?? die("set requires NAME");
    checkName(name);
    const entry = currentEntry(name);
    if (!entry) {
      const owner = packageForMember(name);
      if (owner) die(`Skill is managed by package ${owner}; use packages set`);
      die(`unknown Skill: ${name}`);
    }
    ({ source, path, ref: requested } = entry);
    originalSource = source;
  }
  while (args.length) {
    const option = args.shift()!;
    if (option === "--skill" || option === "--name") {
      if (action !== "add") die("set cannot rename a Skill");
      name = takeValue(args, option);
    } else if (option === "--source") {
      if (action !== "set") die("add takes SOURCE positionally");
      source = takeValue(args, option);
      sourceChanged = true;
      seen = true;
    } else if (option === "--path") {
      path = takeValue(args, option);
      pathExplicit = true;
      seen = true;
    } else if (option === "--ref") {
      requested = takeValue(args, option);
      refExplicit = true;
      seen = true;
    } else die(`unknown option: ${option}`);
  }
  if (!name) die("add requires --skill NAME");
  checkName(name);
  if (action === "add" && currentEntry(name)) die(`Skill already declared; use skills set: ${name}`);
  if (action === "add" && currentPackage(name)) die(`name is already used by a package: ${name}`);
  if (action === "add" && packageForMember(name)) die(`name is already owned by a package: ${name}`);
  if (action === "set" && !seen) die("set requires --source, --path or --ref");
  source = normalizeSource(source);
  if (sourceChanged && source !== originalSource) {
    if (!pathExplicit) path = "";
    if (!refExplicit) requested = "";
  }
  if (!path) path = "?";
  else checkPath(path);
  installEntry({ name, source, path, ref: resolveRef(source, requested) }, true);
}

function packageAddOrSet(action: "add" | "set", args: string[]): void {
  let name = "";
  let source = "";
  let path = DEFAULT_PACKAGE_PATH;
  let selector = DEFAULT_PACKAGE_SELECTOR;
  let requested = "";
  let seen = false;
  let sourceChanged = false;
  let pathExplicit = false;
  let selectorExplicit = false;
  let refExplicit = false;
  let originalSource = "";
  if (action === "add") {
    if (args.length < 2) die("packages add requires NAME and SOURCE");
    name = args.shift()!;
    source = args.shift()!;
  } else {
    name = args.shift() ?? die("packages set requires NAME");
    checkName(name);
    const pkg = currentPackage(name) ?? die(`unknown package: ${name}`);
    ({ source, path, selector, ref: requested } = pkg);
    originalSource = source;
  }
  while (args.length) {
    const option = args.shift()!;
    if (option === "--source") {
      if (action !== "set") die("add takes SOURCE positionally");
      source = takeValue(args, option);
      sourceChanged = true;
      seen = true;
    } else if (option === "--path") {
      path = takeValue(args, option);
      pathExplicit = true;
      seen = true;
    } else if (option === "--selector") {
      selector = takeValue(args, option);
      selectorExplicit = true;
      seen = true;
    } else if (option === "--ref") {
      requested = takeValue(args, option);
      refExplicit = true;
      seen = true;
    } else die(`unknown option: ${option}`);
  }
  checkName(name);
  if (action === "add") {
    if (currentPackage(name)) die(`package already declared: ${name}`);
    if (currentEntry(name)) die(`name is already used by a Skill: ${name}`);
  } else if (!seen) die("packages set requires --source, --path, --selector or --ref");
  source = normalizeSource(source);
  if (sourceChanged && source !== originalSource) {
    if (!pathExplicit) path = DEFAULT_PACKAGE_PATH;
    if (!selectorExplicit) selector = DEFAULT_PACKAGE_SELECTOR;
    if (!refExplicit) requested = "";
  }
  checkPath(path);
  checkSelector(selector);
  installPackage({ name, source, path, selector, ref: resolveRef(source, requested) }, true, true);
}

function updatePackages(selected = "", selectedMember = ""): boolean {
  if (selected && !currentPackage(selected) && !packageForMember(selected)) die(`unknown package or package member: ${selected}`);
  let failed = false;
  for (const pkg of readManifest().packages ?? []) {
    if (selected && selected !== pkg.name && !packageContainsMember(pkg.name, selected)) continue;
    let ref: string;
    try {
      ref = resolveRef(pkg.source, "");
    } catch (error) {
      reportError(error);
      err(`cannot resolve upstream package: ${pkg.name}; keeping its recorded version`);
      failed = true;
      continue;
    }
    try {
      installPackage({ ...pkg, ref }, true, true, selectedMember);
    } catch (error) {
      reportError(error);
      err(`package upgrade not completed: ${pkg.name}; its previous record was retained`);
      failed = true;
    }
  }
  return !failed;
}

function updateSkills(selected = ""): boolean {
  let failed = false;
  let packageOwner = "";
  if (selected) {
    checkName(selected);
    packageOwner = packageForMember(selected);
    if (!currentEntry(selected) && !currentPackage(selected) && !packageOwner) die(`unknown Skill or package: ${selected}`);
  }
  const snapshot = readManifest();
  if (!selected || currentEntry(selected)) {
    for (const entry of snapshot.skills) {
      if (selected && selected !== entry.name) continue;
      let ref: string;
      try {
        ref = resolveRef(entry.source, "");
      } catch (error) {
        reportError(error);
        err(`cannot resolve upstream for ${entry.name}; keeping its recorded version`);
        failed = true;
        continue;
      }
      try {
        installEntry({ ...entry, ref }, true);
      } catch (error) {
        reportError(error);
        err(`upgrade not completed for ${entry.name}; its previous record was retained`);
        failed = true;
      }
    }
  }
  if (!selected) failed = !updatePackages() || failed;
  else if (currentPackage(selected)) failed = !updatePackages(selected) || failed;
  else if (packageOwner) failed = !updatePackages(packageOwner, selected) || failed;
  return !failed;
}

function reportError(error: unknown): void {
  err(error instanceof Error ? error.message : String(error));
}

function initializePaths(): void {
  if (!/^(?:[A-Za-z]:[\\/]|\/)/.test(TARGET_HOME)) die("target home must be an absolute path");
  if (/[\r\n]/.test(`${TARGET_HOME}${REPO}`)) die("repository and target paths cannot contain line breaks");
  if (resolve(TARGET_HOME) === resolve(SYSTEM_HOME)) {
    stateRoot = join(process.env.XDG_STATE_HOME || join(TARGET_HOME, ".local", "state"), "agent-recipes");
    nativeLock = process.env.XDG_STATE_HOME ? join(process.env.XDG_STATE_HOME, "skills", ".skill-lock.json") : join(TARGET_HOME, ".agents", ".skill-lock.json");
  } else {
    stateRoot = join(TARGET_HOME, ".local", "state", "agent-recipes");
    nativeLock = join(TARGET_HOME, ".agents", ".skill-lock.json");
  }
  statePath = join(stateRoot, "state.json");
  backups = join(stateRoot, "backups");
  skillsDir = join(TARGET_HOME, ".agents", "skills");
}

function cleanup(): void {
  if (active) transactionRollback();
  if (tmp) rmSync(tmp, { recursive: true, force: true });
  if (locked) {
    try {
      rmdirSync(join(stateRoot, ".running"));
    } catch {
      // A stale lock is reported on the next mutating run.
    }
  }
}

function main(argv: string[]): number {
  if (argv[0] === "--version") {
    if (argv.length !== 1) die("--version takes no arguments");
    say(`agent-recipes ${APP_VERSION}`);
    return 0;
  }
  const args = argv.filter((arg) => {
    if (arg === "--force") {
      force = true;
      return false;
    }
    return true;
  });
  if (["--help", "-h", "help"].includes(args[0] ?? "")) {
    help();
    return 0;
  }
  if (args[0] === "mcp") {
    if (args.length !== 1) die("mcp takes no arguments; it only prints configuration steps");
    mcpGuide();
    return 0;
  }
  initializePaths();
  readManifest();
  validateMcps();
  if (args[0] === "skills" && args[1] === "list") {
    if (args.length !== 2) die("skills list takes no arguments");
    tmp = mkdtempSync(join(tmpdir(), "agent-recipes-list."));
    sourceCacheRoot = join(tmp, "source-cache");
    mkdirSync(sourceCacheRoot);
    listSkills();
    return 0;
  }
  if (args[0] === "packages" && args[1] === "list") {
    if (args.length !== 2) die("packages list takes no arguments");
    tmp = mkdtempSync(join(tmpdir(), "agent-recipes-list."));
    sourceCacheRoot = join(tmp, "source-cache");
    mkdirSync(sourceCacheRoot);
    listPackages();
    return 0;
  }
  ensureMutation();
  if (args.length === 0) {
    let failed = !syncRules();
    for (const entry of readManifest().skills) {
      try {
        installEntry(entry, false);
      } catch (error) {
        reportError(error);
        failed = true;
      }
    }
    for (const pkg of readManifest().packages ?? []) {
      try {
        installPackage(pkg, false, false);
      } catch (error) {
        reportError(error);
        failed = true;
      }
    }
    say("MCP 配置指引：./setup mcp（仅输出步骤）");
    return failed ? 1 : 0;
  }
  const group = args.shift();
  const action = args.shift();
  if (group === "skills") {
    if (!action) die("skills requires add/remove/set/list/update");
    if (action === "add" || action === "set") addOrSet(action, args);
    else if (action === "remove") {
      if (args.length !== 1) die("remove requires exactly one NAME");
      removeSkill(args[0]);
    } else if (action === "update") {
      if (args.length > 1) die("update accepts at most one NAME");
      return updateSkills(args[0] ?? "") ? 0 : 1;
    } else die(`unknown skills action: ${action}`);
    return 0;
  }
  if (group === "packages") {
    if (!action) die("packages requires add/remove/set/list/update");
    if (action === "add" || action === "set") packageAddOrSet(action, args);
    else if (action === "remove") {
      if (args.length !== 1) die("packages remove requires exactly one NAME");
      removePackage(args[0]);
    } else if (action === "update") {
      if (args.length > 1) die("packages update accepts at most one NAME");
      return updatePackages(args[0] ?? "") ? 0 : 1;
    } else die(`unknown packages action: ${action}`);
    return 0;
  }
  die(`unknown command: ${group} (use --help)`);
}

let exitCode = 1;
process.on("SIGINT", () => {
  cleanup();
  process.exit(130);
});
process.on("SIGTERM", () => {
  cleanup();
  process.exit(143);
});
try {
  exitCode = main(process.argv.slice(2));
} catch (error) {
  reportError(error);
  exitCode = 1;
} finally {
  cleanup();
}
process.exit(exitCode);
